# Postgres (docker compose up -d starts one on 5432)
DATABASE_URL=postgres://voicedesk:voicedesk@localhost:5432/voicedesk

PORT=8787

# AI provider: mock | openai | anthropic
# mock needs no API key and returns a deterministic insight computed from the records.
AI_PROVIDER=mock
# Second provider tried when the first one's output fails schema/grounding validation (or errors).
# openai | anthropic | none. Default: the other real provider, if its key is set.
# AI_FALLBACK_PROVIDER=anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# Mock-only: make the primary mock return schema-invalid output so the fallback path runs offline.
# MOCK_PRIMARY_INVALID=false

# Optional bearer token. When set, every route except /health requires `Authorization: Bearer <API_KEY>`.
# API_KEY=

# OpenTelemetry: console (default) | otlp | none
OTEL_TRACES_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=voicedesk-insights
